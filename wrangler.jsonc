{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "media-by-bela",
  "main": "src/index.js",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_PUBLISHABLE_KEY",
      "SUPABASE_SECRET_KEY"
    ]
  }
}
