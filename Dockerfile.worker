# ---------------------------------------------------------------------------
# Camada de API (Cloudflare Worker) — modo Docker
#
# Roda EXATAMENTE o mesmo src/index.js que vai para a Cloudflare, usando o
# runtime oficial (workerd) através do `wrangler dev`. Nenhuma linha de
# código da aplicação muda: o mesmo `env.SUPABASE_*`, os mesmos cookies,
# as mesmas rotas.
#
# Debian (node:22-slim) e não Alpine: o binário do workerd é compilado
# contra glibc e não roda em musl.
# ---------------------------------------------------------------------------
FROM node:22-slim

WORKDIR /app

ENV NODE_ENV=development \
    CI=1 \
    WRANGLER_SEND_METRICS=false

# Dependências primeiro, para aproveitar o cache de camadas do Docker
COPY package.json package-lock.json ./
RUN npm ci

# Código e configuração do Worker
COPY wrangler.jsonc ./
COPY src/ ./src/
COPY public/ ./public/

EXPOSE 8787

# Healthcheck: qualquer resposta HTTP já significa que o workerd subiu.
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:8787/api/health').then(()=>process.exit(0)).catch(()=>process.exit(1))"

# --ip 0.0.0.0 é obrigatório: sem isso o wrangler escuta só em 127.0.0.1
# dentro do container e o nginx não consegue alcançá-lo.
CMD ["npx", "wrangler", "dev", "--ip", "0.0.0.0", "--port", "8787"]
